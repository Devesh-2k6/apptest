{
  "name": "meeva-selenium-tests",
  "version": "1.0.0",
  "description": "End-to-End Selenium WebDriver Automated Test Suite for Meeva Web Frontend",
  "main": "tests/login-tests.js",
  "type": "module",
  "scripts": {
    "test": "node tests/login-tests.js",
    "test:headed": "set HEADLESS=false && node tests/login-tests.js",
    "test:chrome": "set BROWSER=chrome && node tests/login-tests.js",
    "test:firefox": "set BROWSER=firefox && node tests/login-tests.js",
    "test:edge": "set BROWSER=MicrosoftEdge && node tests/login-tests.js"
  },
  "keywords": [
    "selenium",
    "webdriver",
    "e2e-testing",
    "meeva",
    "auth-testing",
    "regression"
  ],
  "author": "Meeva QA Automation Team",
  "license": "ISC",
  "dependencies": {
    "selenium-webdriver": "^4.27.0"
  },
  "devDependencies": {
    "chromedriver": "^131.0.0"
  }
}
